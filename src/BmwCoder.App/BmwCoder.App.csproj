    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BmwCoder.Transport\BmwCoder.Transport.csproj" />
    <ProjectReference Include="..\BmwCoder.Uds\BmwCoder.Uds.csproj" />
    <ProjectReference Include="..\BmwCoder.Coding\BmwCoder.Coding.csproj" />
    <ProjectReference Include="..\BmwCoder.Core\BmwCoder.Core.csproj" />
  </ItemGroup>

</Project>
